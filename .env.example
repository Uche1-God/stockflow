# Copy this to .env for local development (or set these in Railway's
# "Variables" tab for deployment).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated list of extra allowed hosts (Railway's domain is added
# automatically via RAILWAY_PUBLIC_DOMAIN, no need to add it here).
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway sets this automatically when you attach a Postgres database.
# Leave unset locally to use SQLite.
# DATABASE_URL=postgres://user:password@host:port/dbname
